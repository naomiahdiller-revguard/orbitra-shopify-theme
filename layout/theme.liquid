<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    >

    <meta name="theme-color" content="#05060a">

    <title>
      {% if page_title %}
        {{ page_title }}
        {% unless page_title contains shop.name %}
          — {{ shop.name }}
        {% endunless %}
      {% else %}
        Orbitra — LED Flying Orb
      {% endif %}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">

    <!-- Shopify-required scripts, apps, analytics, and checkout functionality -->
    {{ content_for_header }}

    <!-- Orbitra global styles -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="orbitra-site">

    <!-- Ambient background used throughout the Orbitra experience -->
    <div class="orbitra-ambient" aria-hidden="true">
      <div class="orbitra-ambient__glow orbitra-ambient__glow--blue"></div>
      <div class="orbitra-ambient__glow orbitra-ambient__glow--violet"></div>
      <div class="orbitra-ambient__noise"></div>
    </div>

    <!-- Accessibility: lets keyboard users skip directly to the page -->
    <a class="skip-to-content-link" href="#MainContent">
      Skip to content
    </a>

    <main
      id="MainContent"
      class="orbitra-main"
      role="main"
      tabindex="-1"
    >
      {{ content_for_layout }}
    </main>

    <!-- Global Orbitra interaction and animation code -->
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

  </body>
</html>