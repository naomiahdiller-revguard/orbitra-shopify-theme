{% liquid

  assign orbitra_product = section.settings.product

 

  if orbitra_product == blank and collections.all.products.size > 0

    assign orbitra_product = collections.all.products.first

  endif

%}

 

<section class="orbitra-product" id="shop-orbitra">

  <div class="orbitra-container orbitra-product__grid">

 

    <div class="orbitra-product-gallery" data-product-gallery data-reveal tabindex="0">

 

      <div class="orbitra-product-gallery__stage">

        <div class="orbitra-product-gallery__track">

 

          {% for i in (1..7) %}

            <div

              class="orbitra-product-gallery__slide{% if forloop.first %} is-active{% endif %}"

              data-gallery-slide

              data-index="{{ forloop.index0 }}"

            >

              <img

                src="{{ 'product-photo-' | append: i | append: '.png' | asset_url }}"

                alt="Orbitra LED Flying Orb product image {{ i }}"

                loading="lazy"

                width="1200"

                height="1200"

              >

            </div>

          {% endfor %}

 

        </div>

 

        <button

          class="orbitra-gallery-arrow orbitra-gallery-arrow--previous"

          type="button"

          data-gallery-previous

          aria-label="Previous product image"

        >

          <span aria-hidden="true">←</span>

        </button>

 

        <button

          class="orbitra-gallery-arrow orbitra-gallery-arrow--next"

          type="button"

          data-gallery-next

          aria-label="Next product image"

        >

          <span aria-hidden="true">→</span>

        </button>

 

        <div class="orbitra-gallery-counter" aria-live="polite">

          <span data-gallery-current>1</span>

          <span>/</span>

          <span>7</span>

        </div>

      </div>

 

      <div class="orbitra-product-gallery__thumbnails" aria-label="Product images">

 

        {% for i in (1..7) %}

          <button

            class="orbitra-product-gallery__thumbnail{% if forloop.first %} is-active{% endif %}"

            type="button"

            data-gallery-thumbnail

            data-index="{{ forloop.index0 }}"

            aria-label="View product image {{ i }}"

            {% if forloop.first %}aria-current="true"{% endif %}

          >

            <img

              src="{{ 'product-photo-' | append: i | append: '.png' | asset_url }}"

              alt=""

              loading="lazy"

              width="160"

              height="160"

            >

          </button>

        {% endfor %}

 

      </div>

    </div>

 

    <div class="orbitra-product__content">

      <p class="orbitra-eyebrow" data-reveal>YOUR ORBITRA</p>

 

      <h2 class="orbitra-section-title orbitra-product__title" data-reveal data-reveal-delay="1">

        Ready when you are.

      </h2>

 

      {% if orbitra_product != blank %}

        <div class="orbitra-product__price" data-reveal data-reveal-delay="2">

          <span>{{ orbitra_product.price | money }}</span>
          <span class="orbitra-product__shipping">Free shipping</span>

 

          {% if orbitra_product.compare_at_price > orbitra_product.price %}

            <s>{{ orbitra_product.compare_at_price | money }}</s>

          {% endif %}

        </div>

      {% endif %}

 

      <p class="orbitra-subtitle" data-reveal data-reveal-delay="2">

        One blue LED flying orb with the included remote, USB charging cable, and instruction manual.

      </p>

 

      <ul class="orbitra-product__included" data-reveal data-reveal-delay="2">

        <li>1 blue flying orb</li>

        <li>1 remote control</li>

        <li>1 USB charging cable</li>

        <li>1 instruction manual</li>

      </ul>

 

      {% if orbitra_product != blank %}

 

        {% form 'product', orbitra_product, class: 'orbitra-product-form', data-reveal: '' %}

 

          <input

            type="hidden"

            name="id"

            value="{{ orbitra_product.selected_or_first_available_variant.id }}"

          >

 

          <div class="orbitra-product-form__row">

            <label for="OrbitraQuantity-{{ section.id }}">Quantity</label>

 

            <div class="orbitra-quantity">

              <button

                type="button"

                class="orbitra-quantity__button"

                data-quantity-minus

                aria-label="Decrease quantity"

              >−</button>

 

              <input

                id="OrbitraQuantity-{{ section.id }}"

                type="number"

                name="quantity"

                value="1"

                min="1"

                inputmode="numeric"

                data-quantity-input

              >

 

              <button

                type="button"

                class="orbitra-quantity__button"

                data-quantity-plus

                aria-label="Increase quantity"

              >+</button>

            </div>

          </div>

 

          <button

            type="submit"

            name="add"

            class="orbitra-button orbitra-product__add"

            {% unless orbitra_product.selected_or_first_available_variant.available %}

              disabled

            {% endunless %}

          >

            {% if orbitra_product.selected_or_first_available_variant.available %}

              Add to cart

            {% else %}

              Sold out

            {% endif %}

          </button>

 

          {{ form | payment_button }}

 

        {% endform %}

 

      {% else %}

 

        <div class="orbitra-product__setup orbitra-glass">

          Select the Orbitra product in this section's Shopify theme settings.

        </div>

 

      {% endif %}

 

      <p class="orbitra-product__note" data-reveal>

        Battery: 3.7V 120mAh · Approx. 8–10 m control distance

      </p>

 

    </div>

 

  </div>

</section>

 

{% schema %}

{

  "name": "Orbitra Product",

  "settings": [

    {

      "type": "product",

      "id": "product",

      "label": "Orbitra product"

    }

  ],

  "presets": [

    {

      "name": "Orbitra Product"

    }

  ]

}

{% endschema %}