<section class="orbitra-faq" id="orbitra-faq">

  <div class="orbitra-container orbitra-faq__grid">

 

    <div class="orbitra-faq__intro">

      <p class="orbitra-eyebrow" data-reveal>QUESTIONS, ANSWERED</p>

 

      <h2 class="orbitra-section-title" data-reveal data-reveal-delay="1">

        Everything you need to know.

      </h2>

 

      <p class="orbitra-subtitle" data-reveal data-reveal-delay="2">

        The essentials before your first flight.

      </p>

    </div>

 

    <div class="orbitra-faq__list">

 

      <details class="orbitra-faq__item" data-reveal>

        <summary>

          <span>How long does Orbitra fly?</span>

          <i aria-hidden="true"></i>

        </summary>

 

        <div class="orbitra-faq__answer">

          <p>The supplier specification lists approximately 6–8 minutes of flight time per charge.</p>

        </div>

      </details>

 

      <details class="orbitra-faq__item" data-reveal>

        <summary>

          <span>How long does charging take?</span>

          <i aria-hidden="true"></i>

        </summary>

 

        <div class="orbitra-faq__answer">

          <p>The listed charging time is approximately 30–35 minutes using the included USB cable.</p>

        </div>

      </details>

 

      <details class="orbitra-faq__item" data-reveal>

        <summary>

          <span>What comes in the box?</span>

          <i aria-hidden="true"></i>

        </summary>

 

        <div class="orbitra-faq__answer">

          <p>One blue flying orb, one remote control, one USB charging cable, and one instruction manual.</p>

        </div>

      </details>

 

      <details class="orbitra-faq__item" data-reveal>

        <summary>

          <span>How do I start it?</span>

          <i aria-hidden="true"></i>

        </summary>

 

        <div class="orbitra-faq__answer">

          <p>Turn on the power, hold the center axis, spin the wheel to start the rotor, then use a controlled toss.</p>

        </div>

      </details>

 

    </div>

  </div>

 

  <div class="orbitra-final-cta orbitra-container" data-reveal>

    <div>

      <p class="orbitra-eyebrow">SEE IT FOR YOURSELF</p>

      <h2>Ready to put Orbitra in motion?</h2>

    </div>

 

    <a href="#shop-orbitra" class="orbitra-button">

      Shop Orbitra <span aria-hidden="true">→</span>

    </a>

  </div>

 

  <footer class="orbitra-footer orbitra-container">

    <span>ORBITRA</span>

    <span>© {{ 'now' | date: '%Y' }} Orbitra</span>

  </footer>

</section>

 

{% schema %}

{

  "name": "Orbitra FAQ",

  "settings": [],

  "presets": [

    {

      "name": "Orbitra FAQ"

    }

  ]

}

{% endschema %}

