<section class="orbitra-video-page">

  <div class="orbitra-container">

 

    <nav class="orbitra-video-page__nav">

      <a href="/" class="orbitra-nav__logo" aria-label="Orbitra home">ORBITRA</a>

 

      <a href="/#shop-orbitra" class="orbitra-video-page__shop">

        Shop Orbitra

        <span aria-hidden="true">→</span>

      </a>

    </nav>

 

    <div class="orbitra-video-page__intro">

      <p class="orbitra-eyebrow" data-reveal>SEE IT IN ACTION</p>

 

      <h1 class="orbitra-video-page__title" data-reveal data-reveal-delay="1">

        Throw it.

        <span>Watch it fly.</span>

      </h1>

 

      <p class="orbitra-subtitle orbitra-video-page__lead" data-reveal data-reveal-delay="2">

        Orbitra is made to move. Watch the throw, the curve, and the catch in real footage.

      </p>

    </div>

 

    <div class="orbitra-video-shell orbitra-glass" data-reveal>

      <div class="orbitra-video-frame">

 

        <video

          class="orbitra-action-video"

          data-orbitra-story-video

          autoplay

          muted

          loop

          playsinline

          preload="metadata"

          aria-label="Orbitra flying orb in action"

        >

          <source

            src="{{ 'orbita-custom-video-1.mp4' | asset_url }}"

            type="video/mp4"

          >

          Your browser does not support HTML5 video.

        </video>

 

        <button type="button" class="orbitra-video-sound" data-orbitra-sound-toggle aria-pressed="false" aria-label="Turn video sound on">
            <span class="orbitra-video-sound__icon" data-orbitra-muted-icon aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false"><path d="M11 5 6.8 8.5H3v7h3.8L11 19V5Z"/><path d="m16 9 5 6M21 9l-5 6"/></svg>
            </span>
            <span class="orbitra-video-sound__icon" data-orbitra-sound-icon aria-hidden="true" hidden>
              <svg viewBox="0 0 24 24" focusable="false"><path d="M11 5 6.8 8.5H3v7h3.8L11 19V5Z"/><path d="M15 9.2a4 4 0 0 1 0 5.6M18 6.5a7.5 7.5 0 0 1 0 11"/></svg>
            </span>
          </button>

 

      </div>

 

      <div class="orbitra-video-page__caption">

        <span>THROW</span>

        <i></i>

        <span>FLY</span>

        <i></i>

        <span>CATCH</span>

        <i></i>

        <span>REPEAT</span>

      </div>

    </div>

 

    <div class="orbitra-video-page__cta" data-reveal>

      <p class="orbitra-eyebrow">READY TO TRY IT?</p>

 

      <h2>

        Put Orbitra in motion.

      </h2>

 

      <a href="/#shop-orbitra" class="orbitra-button">

        Shop Orbitra

        <span aria-hidden="true">→</span>

      </a>

    </div>

 

  </div>

</section>

 

{% schema %}

{

  "name": "Orbitra Action Video",

  "settings": [],

  "presets": [

    {

      "name": "Orbitra Action Video"

    }

  ]

}

{% endschema %}